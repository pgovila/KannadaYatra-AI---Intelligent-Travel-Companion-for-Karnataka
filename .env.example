# ──────────────────────────────────────────────────────────────────────
# KannadaYatra AI - Environment Variable Template
# Copy this file to .env and fill in your API key(s).
# ──────────────────────────────────────────────────────────────────────

# Google Gemini API Key (required for AI itinerary generation)
# Obtain from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (optional - defaults to gemini-2.5-flash with auto-fallback)
# Options: gemini-2.5-flash, gemini-2.5-pro, gemini-2.0-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Optional: Qwen model endpoint (fallback LLM)
# QWEN_API_KEY=your_qwen_api_key_here
# QWEN_API_BASE=https://api.together.xyz/v1

